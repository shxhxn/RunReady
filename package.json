{
  "name": "runready",
  "displayName": "RunReady",
  "description": "Find and fill the exact command that runs your project—without guessing.",
  "version": "0.2.1",
  "publisher": "shxhxn",
  "author": {
    "name": "Shahan Samar",
    "url": "https://github.com/shxhxn"
  },
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/runready-icon-256.png",
  "galleryBanner": {
    "color": "#0736B8",
    "theme": "dark"
  },
  "pricing": "Free",
  "preview": true,
  "qna": "marketplace",
  "homepage": "https://github.com/shxhxn/RunReady#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shxhxn/RunReady.git"
  },
  "bugs": {
    "url": "https://github.com/shxhxn/RunReady/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other"],
  "keywords": [
    "run",
    "project",
    "terminal",
    "dependencies",
    "npm",
    "python",
    "react",
    "vite",
    "developer tools",
    "project launcher"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "test": "node smoke-test.cjs",
    "package": "vsce package",
    "publish:patch": "vsce publish patch",
    "publish:minor": "vsce publish minor"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:runready.findAndRun",
    "onCommand:runready.inspectProject",
    "onCommand:runready.showStatusButton"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "RunReady can inspect and copy commands in Restricted Mode, but it will not send them to a terminal."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "runready.findAndRun",
        "title": "Find and Run Project",
        "category": "RunReady",
        "icon": "$(play)"
      },
      {
        "command": "runready.inspectProject",
        "title": "Inspect Project Command",
        "category": "RunReady",
        "icon": "$(search)"
      },
      {
        "command": "runready.showStatusButton",
        "title": "Show Status Bar Button",
        "category": "RunReady",
        "icon": "$(pin)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "runready.findAndRun",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "runready.inspectProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ],
      "editor/title": [
        {
          "command": "runready.findAndRun",
          "when": "resourceScheme == file",
          "group": "navigation@20"
        }
      ]
    },
    "configuration": {
      "title": "RunReady",
      "properties": {
        "runready.shellStyle": {
          "type": "string",
          "enum": ["auto", "powershell", "bash", "cmd"],
          "default": "auto",
          "description": "Shell syntax used for the generated cd and chained commands. Auto uses PowerShell on Windows and Bash elsewhere."
        },
        "runready.includeDependencyInstall": {
          "type": "boolean",
          "default": true,
          "description": "Include safe dependency installation/restoration commands when dependencies appear to be missing."
        },
        "runready.scanDepth": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 12,
          "description": "Maximum folder depth searched for runnable projects."
        }
      }
    }
  }
}
